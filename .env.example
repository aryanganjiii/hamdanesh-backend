# Copy this file to .env and add your own AvalAI API key.
AI_ASSISTANT_ENABLED=1
AVALAI_API_KEY=replace-with-your-avalai-api-key
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_CHAT_MODEL=gpt-5.4-mini
AVALAI_EMBEDDING_MODEL=text-embedding-3-small
AVALAI_TIMEOUT_SECONDS=90
AVALAI_MAX_OUTPUT_TOKENS=900
AI_ASSISTANT_MAX_MESSAGE_CHARS=1000
AI_ASSISTANT_HISTORY_MESSAGES=12
DOCUMENT_MAX_BYTES=12582912
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=220
KNOWLEDGE_DB_PATH=data/knowledge.sqlite3
PORT=8000
